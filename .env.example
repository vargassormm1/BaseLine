# Baseline V2 — copy to .env.local (never commit real values). All server-only.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx          # publishable/anon key (RLS protects the data)
# Google sign-in is configured in the Supabase dashboard (Auth → Providers → Google), not here.
# Local browser tests only (playwright.config.ts sets these; never set them on Vercel):
# BASELINE_E2E=1
# E2E_JWT_SECRET=<local supabase JWT secret>
